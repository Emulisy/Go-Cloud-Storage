# Copy to .env and replace the placeholders with your own values.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=gocloudstorage
MYSQL_USER=gocloudstorage
MYSQL_PASSWORD=replace-with-a-strong-app-password

REDIS_DB=0
REDIS_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-bytes

# MinIO server settings. Put minio.license in MINIO_CONFIG_DIR.
MINIO_CONFIG_DIR=/etc/gocloudstorage/minio
# MINIO_ROOT_USER=<unique-admin-access-key>
# MINIO_ROOT_PASSWORD=<unique-admin-secret-key>

# MinIO app settings. Use credentials scoped to the app's bucket.
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=cloud-storage
MINIO_ACCESS_KEY_ID=replace-with-bucket-access-key
MINIO_SECRET_ACCESS_KEY=replace-with-bucket-secret-key
MINIO_REGION=us-east-1
